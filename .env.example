# Copy to .env (git-ignored) and fill in. Never commit the filled-in file. See docs/self-hosting.md.

# The public URL of the MCP endpoint, exactly as clients reach it: scheme, host, port and the /mcp path.
HITCH_RESOURCE_URI=https://mail.example.org/mcp

# openssl rand -hex 32
MCP4MAIL_DATABASE_PASSWORD=
# openssl rand -hex 64
SECRET_KEY_BASE=

# Encrypt mailbox passwords at rest. Generate with: bin/rails db:encryption:init
# Losing them makes every stored mailbox password unreadable; back them up.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Host port the app is published on; point your reverse proxy at it.
MCP4MAIL_PORT=8080

# Where unhandled errors and 500s are emailed (comma separated). Unset, they go to chmel@jchsoft.cz,
# the operator of the hosted instance; empty switches the emails off. Needs the SMTP settings in
# config/environments/production.rb (docs/self-hosting.md, "Email").
#EXCEPTION_NOTIFICATION_RECIPIENTS=
