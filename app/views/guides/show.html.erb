<% content_for :title, t(".title", provider: @guide.title) %>
<% content_for :description, @guide.summary if @guide.summary.present? %>
<% content_for :head, tag.link(rel: "canonical", href: guide_url(@guide)) %>

<article class="max-w-[760px] pt-[72px] pb-16">
  <%= link_to "← #{t(".back")}", guides_path, class: "inline-flex items-center text-sm font-semibold text-green hover:text-green-deep max-lg:min-h-11" %>

  <h1 class="mt-4 font-heading text-h2 font-extrabold"><%= @guide.title %></h1>

  <div class="mt-6 flex flex-wrap gap-3 text-sm">
    <% if @guide.imap_host.present? %>
      <p class="inline-flex items-center gap-2 rounded-full bg-green-tint px-3.5 py-1.5 text-green-deep">
        <span class="font-semibold"><%= t(".imap_host") %>:</span>
        <code class="font-code"><%= @guide.imap_host %></code>
      </p>
    <% end %>
    <% if @guide.needs_app_password? %>
      <p class="inline-flex items-center rounded-full bg-brand-tint px-3.5 py-1.5 font-semibold text-ink" title="<%= t(".app_password_note") %>">
        <%= t(".app_password") %>
      </p>
    <% end %>
  </div>

  <div class="guide-prose mt-10">
    <%= @guide.html %>
  </div>
</article>

<section aria-labelledby="guide-connect-heading" class="mb-24 max-w-[760px] rounded-[22px] bg-brand-tint p-8">
  <h2 id="guide-connect-heading" class="font-heading text-[28px] font-extrabold"><%= t(".connect.heading") %></h2>
  <p class="mt-3 text-[17px] leading-[1.55] text-ink-soft"><%= t(".connect.body") %></p>
  <%= link_to t(".connect.cta"), new_mail_account_path,
              class: "mt-6 inline-flex items-center rounded-full bg-brand px-[26px] py-[15px] text-[16px] font-bold text-ink no-underline hover:bg-brand-hover" %>
</section>
