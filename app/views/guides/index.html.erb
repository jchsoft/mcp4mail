<% content_for :title, t(".title") %>
<% content_for :description, t(".description") %>
<% content_for :head, tag.link(rel: "canonical", href: guides_url) %>

<section class="pt-[72px] pb-24">
  <p class="text-sm font-bold uppercase tracking-[0.08em] text-brand-deep"><%= t(".kicker") %></p>
  <h1 class="mt-3 font-heading text-h2 font-extrabold"><%= t(".heading") %></h1>
  <p class="mt-5 max-w-[40em] text-[19px] leading-[1.55] text-ink-soft"><%= t(".lede") %></p>

  <ul class="mt-12 grid grid-cols-[repeat(auto-fill,minmax(min(100%,260px),1fr))] gap-5">
    <% @guides.each do |guide| %>
      <li>
        <%= link_to guide_path(guide), class: "flex h-full flex-col gap-2 rounded-[22px] border border-line bg-surface p-6 text-ink no-underline hover:bg-surface-hover" do %>
          <h2 class="font-heading text-[22px] font-bold"><%= guide.title %></h2>
          <p class="text-[15px] leading-[1.5] text-ink-soft"><%= guide.summary %></p>
          <span class="mt-auto pt-2 text-sm font-semibold text-green"><%= t(".read_guide") %> →</span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
