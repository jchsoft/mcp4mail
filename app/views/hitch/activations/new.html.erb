<%# Overrides hitch-rails' device-activation code entry. The warning is a
    security control, not decoration (RFC 8628 §5.4): the flow's known abuse
    is a stranger sending someone a code to enter, so its meaning stays intact
    in both languages. %>
<% content_for :title, t(".title") %>

<div class="mx-auto my-12 max-w-[560px] rounded-[20px] border border-line bg-surface p-6 sm:p-10 max-sm:my-8">
  <h1 class="font-heading text-4xl font-extrabold tracking-[-0.02em] text-ink"><%= t(".title") %></h1>

  <% if @alert %>
    <p role="alert" class="mt-5 rounded-xl border border-danger bg-danger-tint px-4 py-3 font-medium text-danger-deep"><%= hitch_activation_alert(@alert) %></p>
  <% end %>

  <p class="mt-4 text-[17px] leading-[1.6] text-ink-soft"><%= t(".intro") %></p>

  <p class="mt-5 rounded-xl border border-brand bg-brand-tint px-4 py-3 leading-[1.5] text-ink">
    <%= t(".warning_html", brand: @brand_name) %>
  </p>

  <%= form_with url: activate_path, method: :post, data: { turbo: false }, class: "mt-8" do |f| %>
    <%= f.label :user_code, t(".code_label"), class: "block font-semibold text-ink" %>
    <%= f.text_field :user_code, value: @user_code, autocomplete: "off",
          autocapitalize: "characters", spellcheck: false,
          class: "mt-2 block w-full rounded-2xl border-2 border-field-border bg-surface px-4 py-3 text-center font-code text-[32px] font-bold tracking-[.12em] text-ink uppercase placeholder:text-field-placeholder" %>
    <button type="submit" class="mt-5 inline-flex cursor-pointer items-center justify-center rounded-full bg-brand px-[26px] py-[15px] text-[16px] font-bold text-ink no-underline hover:bg-brand-hover max-sm:w-full">
      <%= t(".submit") %>
    </button>
  <% end %>
</div>
