<% content_for :title, t(".title") %>

<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
  <p class="mt-3 text-gray-600"><%= t(".intro") %></p>

  <% if authenticated? && current_user.mail_accounts.none? %>
    <p class="mt-5 py-2 px-3 bg-yellow-50 text-yellow-800 rounded-lg" id="no-mailbox">
      <%= t(".no_mailbox") %>
      <%= link_to t(".add_mailbox"), new_mail_account_path, class: "underline hover:no-underline font-medium" %>
    </p>
  <% end %>

  <section class="mt-8" data-controller="clipboard" data-clipboard-copied-label-value="<%= t(".copied") %>">
    <h2 class="font-bold text-2xl"><%= t(".url_title") %></h2>
    <div class="mt-3 flex gap-2">
      <input type="text" readonly value="<%= @server_url %>" id="server-url" data-clipboard-target="source"
             class="block shadow-sm rounded-md border border-gray-400 px-3 py-2 w-full font-mono bg-gray-50">
      <button type="button" data-clipboard-target="button" data-action="clipboard#copy"
              class="rounded-md px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer"><%= t(".copy") %></button>
    </div>
    <p class="mt-2 text-sm text-gray-600"><%= t(".url_hint") %></p>
  </section>

  <section class="mt-10" id="consent">
    <h2 class="font-bold text-2xl"><%= t(".consent.title") %></h2>
    <p class="mt-3 text-gray-700"><%= t(".consent.description") %></p>
    <ul class="mt-3 list-disc pl-6 text-gray-700">
      <% t(".consent.points").each do |point| %>
        <li><%= point %></li>
      <% end %>
    </ul>
  </section>

  <% @clients.each do |client| %>
    <section class="mt-10" id="client-<%= client %>">
      <h2 class="font-bold text-2xl"><%= t(".clients.#{client}.title") %></h2>
      <ol class="mt-3 list-decimal pl-6 space-y-2 text-gray-700">
        <% t(".clients.#{client}.steps").each do |step| %>
          <li><%= step %></li>
        <% end %>
      </ol>

      <% if client == "cursor" %>
        <div class="mt-3" data-controller="clipboard" data-clipboard-copied-label-value="<%= t(".copied") %>">
          <pre class="p-3 rounded-md bg-gray-900 text-gray-100 text-sm overflow-x-auto" data-clipboard-target="source"><%= JSON.pretty_generate(mcpServers: { mcp4mail: { url: @server_url } }) %></pre>
          <button type="button" data-clipboard-target="button" data-action="clipboard#copy"
                  class="mt-2 text-sm text-blue-600 underline hover:no-underline cursor-pointer"><%= t(".copy") %></button>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
