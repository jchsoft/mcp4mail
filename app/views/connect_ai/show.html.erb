<% content_for :title, t(".title") %>

<div class="mx-auto max-w-[720px]">
  <%= render "shared/page_header", title: t(".title"), lede: t(".intro") %>

  <%# The address stays on the page either way: someone can paste it into their
      client now and add the mailbox afterwards. %>
  <% if authenticated? && current_user.mail_accounts.none? %>
    <%= render "shared/alert", variant: :info, id: "no-mailbox", class: "mb-6",
          body: safe_join([ t(".no_mailbox"),
                            link_to(t(".add_mailbox"), new_mail_account_path,
                                    class: "inline-flex items-center font-semibold text-green underline hover:text-green-deep max-lg:min-h-11") ], " ") %>
  <% end %>

  <section data-controller="clipboard" data-clipboard-copied-label-value="<%= t(".copied") %>">
    <h2 class="sr-only"><%= t(".url_title") %></h2>
    <div class="flex flex-col gap-3 rounded-2xl border border-line bg-surface p-4 sm:flex-row sm:items-center">
      <%# Readonly rather than a <code> block: a tap selects the whole address on
          a phone, which is the fallback when the clipboard API is unavailable. %>
      <input type="text" readonly value="<%= @server_url %>" id="server-url" aria-label="<%= t(".url_title") %>"
             data-clipboard-target="source"
             class="w-full min-w-0 bg-transparent font-code text-lg tracking-tight text-ink sm:text-xl">
      <%# The pill from ButtonHelper, not a class string: the ink label on orange is
          hard rule 2.1, and it only stays right while one recipe defines it. %>
      <button type="button" data-clipboard-target="button" data-action="clipboard#copy"
              class="<%= button_classes(:primary, size: :compact) %> shrink-0 justify-center"><%= t(".copy") %></button>
    </div>
    <p class="mt-3 text-sm text-ink-muted" id="authorization-note"><%= t(".authorization") %></p>
  </section>

  <%# Four short instructions, one visible at a time. Without JavaScript the
      tablist never appears and all four stand under their own headings. %>
  <section class="mt-10" data-controller="tabs">
    <div role="tablist" aria-label="<%= t(".clients_label") %>" data-tabs-target="tablist" hidden
         class="flex flex-wrap gap-1 rounded-xl border border-line bg-surface p-1">
      <% @clients.each do |client| %>
        <button type="button" role="tab" id="tab-<%= client %>" aria-controls="client-<%= client %>"
                aria-selected="false" tabindex="-1" data-tabs-target="tab"
                data-action="tabs#select keydown->tabs#navigate"
                class="grow cursor-pointer rounded-lg px-4 py-2 text-sm font-semibold text-ink-soft hover:bg-surface-hover aria-selected:bg-ink aria-selected:text-white aria-selected:hover:bg-ink max-lg:min-h-11">
          <%= t(".clients.#{client}.title") %>
        </button>
      <% end %>
    </div>

    <% @clients.each do |client| %>
      <div role="tabpanel" id="client-<%= client %>" aria-labelledby="tab-<%= client %>" tabindex="0"
           data-tabs-target="panel" class="mt-6">
        <h2 class="font-heading text-xl font-bold" data-tabs-target="heading"><%= t(".clients.#{client}.title") %></h2>
        <p class="mt-2 leading-[1.6] text-ink-soft"><%= t(".clients.#{client}.steps") %></p>
      </div>
    <% end %>
  </section>
</div>
