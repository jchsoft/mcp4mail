<% content_for :title, t(".title") %>

<div class="mx-auto max-w-[520px]">
  <%= render "shared/page_header", title: t(".title"), lede: t(".lede") %>

  <%= form_with url: password_path(params[:token]), method: :put, class: "contents" do |form| %>
    <%= render "shared/field", form: form, attribute: :password, type: :password,
          label: User.human_attribute_name(:password),
          input: { required: true, autofocus: true, autocomplete: "new-password", maxlength: 72,
                   placeholder: t(".password_placeholder") } %>

    <%= render "shared/field", form: form, attribute: :password_confirmation, type: :password,
          label: User.human_attribute_name(:password_confirmation),
          input: { required: true, autocomplete: "new-password", maxlength: 72,
                   placeholder: t(".password_confirmation_placeholder") } %>

    <div class="mt-8">
      <%= button_submit form, t(".submit"), class: "w-full justify-center sm:w-auto" %>
    </div>
  <% end %>
</div>
