<% content_for :title, t(".title") %>

<div class="mx-auto max-w-[520px]">
  <%= render "shared/page_header", title: t(".title"), lede: t(".lede") %>

  <%= form_with url: passwords_path, class: "contents" do |form| %>
    <%= render "shared/field", form: form, attribute: :email_address, type: :email,
          label: User.human_attribute_name(:email_address),
          input: { required: true, autofocus: true, autocomplete: "username",
                   autocapitalize: "off", spellcheck: false,
                   placeholder: t("sessions.new.email_placeholder"), value: params[:email_address] } %>

    <div class="mt-8 sm:flex sm:items-center sm:gap-5">
      <%= button_submit form, t(".submit"), class: "w-full justify-center sm:w-auto" %>

      <p class="mt-4 text-[15px] text-ink-soft sm:mt-0">
        <%= link_to t(".sign_in"), new_session_path, class: "inline-flex items-center font-semibold text-green underline hover:text-green-deep max-lg:min-h-11" %>
      </p>
    </div>
  <% end %>
</div>
