<%# The last calls against one mailbox. Arguments are never stored, so nothing here is mail content. %>
<%= turbo_frame_tag dom_id(@mail_account, :activity) do %>
  <% if @events.empty? %>
    <p class="mt-3 text-sm text-ink-muted" id="<%= dom_id(@mail_account, :activity_empty) %>"><%= t(".empty") %></p>
  <% else %>
    <ul class="mt-3 divide-y divide-line border-t border-line">
      <% @events.each do |event| %>
        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5 py-2.5 text-sm text-ink-muted">
          <span class="font-semibold text-ink"><%= event.tool_title %></span>
          <span><%= @client_names.fetch(event.client_id, event.client_id) %></span>
          <%= render "shared/badge", variant: outcome_badge_variant(event.outcome),
                label: t(".outcomes.#{event.outcome}") %>
          <span><%= t(".rows", count: event.rows_returned) %></span>
          <%= tag.time t(".when", time: time_ago_in_words(event.created_at)),
                datetime: event.created_at.iso8601, class: "ml-auto" %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
