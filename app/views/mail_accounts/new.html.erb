<% content_for :title, t(".title") %>

<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
  <p class="mt-3 text-gray-600"><%= t(".intro") %></p>

  <% show_me_how = link_to t(".show_me_how"), @guide.present? ? guide_path(@guide) : guides_path,
        target: "_blank", rel: "noopener", class: "font-semibold underline" %>

  <% if @detection_failure %>
    <%= render "shared/alert", variant: :warning, id: "detection-error", class: "mt-5",
          title: t(".detection.#{@detection_failure}", domain: @mail_account.email_address.to_s.split("@").last),
          body: safe_join([ t(".detection.hint"), " ", show_me_how ]) %>
  <% end %>

  <% if @connection_outcome %>
    <%= render "shared/alert", variant: :danger, id: "connection-error", class: "mt-5",
          title: t(".outcomes.#{@connection_outcome}.title"),
          body: safe_join([ t(".outcomes.#{@connection_outcome}.hint"), " ", show_me_how ]) %>
  <% end %>

  <%= form_with model: @mail_account, class: "contents" do |form| %>
    <%= render "shared/error_summary", model: @mail_account %>

    <div class="my-5">
      <%= form.label :email_address, class: "font-medium" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", autocapitalize: "off", spellcheck: false, placeholder: "you@example.com", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :password, class: "font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      <p class="mt-2 text-sm text-gray-600">
        <%= t(".password_hint") %>
        <%= link_to t(".show_me_how"), guides_path, class: "font-medium underline" %>
      </p>
    </div>

    <%# Native disclosure, like the FAQ: closed for everyone detection works for, opened
        whenever the person has to see or type the settings themselves. None of the fields
        inside is `required`, or a closed disclosure would block the submit. %>
    <%= tag.details open: @detection_failure.present? || @mail_account.host.present?, class: "my-5 rounded-lg border border-gray-200 px-4 py-3", id: "connection-details" do %>
      <summary class="font-medium cursor-pointer"><%= t(".connection_details") %></summary>
      <p class="mt-2 text-sm text-gray-600"><%= t(".connection_details_hint") %></p>

      <div class="mt-4 grid sm:grid-cols-6 gap-4">
        <div class="sm:col-span-3">
          <%= form.label :host, class: "font-medium" %>
          <%= form.text_field :host, placeholder: "imap.example.com", autocapitalize: "off", spellcheck: false, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
        </div>
        <div class="sm:col-span-1">
          <%= form.label :port, class: "font-medium" %>
          <%= form.number_field :port, min: 1, max: 65535, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
        </div>
        <div class="sm:col-span-2">
          <%= form.label :tls_mode, class: "font-medium" %>
          <%= form.select :tls_mode, MailAccount::TLS_MODES.map { |mode| [ t(".tls_modes.#{mode}"), mode ] }, {}, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
        </div>
      </div>

      <div class="mt-4">
        <%= form.label :username, class: "font-medium" %>
        <%= form.text_field :username, autocomplete: "off", autocapitalize: "off", spellcheck: false, placeholder: t(".username_placeholder"), class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
    <% end %>

    <div class="sm:flex sm:items-center sm:gap-4">
      <%= form.submit t(".submit"), data: { turbo_submits_with: t(".submitting") }, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
      <p class="mt-4 text-sm text-gray-500 sm:mt-0"><%= t(".submit_hint") %></p>
    </div>
  <% end %>
</div>
