<% content_for :title, t(".title") %>

<div class="mx-auto md:w-2/3 w-full" data-controller="mail-provider">
  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
  <p class="mt-3 text-gray-600"><%= t(".intro") %></p>

  <% if @connection_outcome %>
    <div class="mt-5 py-2 px-3 bg-red-50 text-red-600 rounded-lg" id="connection-error">
      <p class="font-medium"><%= t(".outcomes.#{@connection_outcome}.title") %></p>
      <p class="text-sm"><%= t(".outcomes.#{@connection_outcome}.hint") %></p>
    </div>
  <% end %>

  <%= form_with model: @mail_account, class: "contents" do |form| %>
    <% if @mail_account.errors.any? %>
      <ul class="mt-5 py-2 px-3 bg-red-50 text-red-500 font-medium rounded-lg" id="errors">
        <% @mail_account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div class="my-5">
      <%= label_tag :provider, t(".provider"), class: "font-medium" %>
      <%= select_tag :provider,
            options_for_select(MailProvider.all.map { |preset|
              [ preset.name, preset.key, { data: { host: preset.host, port: preset.port, ssl: preset.ssl, hint: t("mail_accounts.providers.#{preset.key}") } } ]
            }),
            include_blank: t(".provider_other"),
            data: { mail_provider_target: "select", action: "mail-provider#apply" },
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      <p class="mt-2 text-sm text-gray-600" data-mail-provider-target="hint" hidden></p>
    </div>

    <div class="grid sm:grid-cols-6 gap-4">
      <div class="sm:col-span-4">
        <%= form.label :host, class: "font-medium" %>
        <%= form.text_field :host, required: true, placeholder: "imap.example.com", autocapitalize: "off", spellcheck: false, data: { mail_provider_target: "host" }, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
      <div class="sm:col-span-1">
        <%= form.label :port, class: "font-medium" %>
        <%= form.number_field :port, required: true, min: 1, max: 65535, data: { mail_provider_target: "port" }, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
      <div class="sm:col-span-1 flex items-end pb-2">
        <%= form.label :ssl, class: "font-medium flex items-center gap-2" do %>
          <%= form.check_box :ssl, data: { mail_provider_target: "ssl" } %> SSL/TLS
        <% end %>
      </div>
    </div>

    <div class="my-5">
      <%= form.label :username, class: "font-medium" %>
      <%= form.text_field :username, required: true, autocomplete: "off", autocapitalize: "off", spellcheck: false, placeholder: t(".username_placeholder"), class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :password, class: "font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      <p class="mt-2 text-sm text-gray-600"><%= t(".password_hint") %></p>
    </div>

    <div class="my-5">
      <%= form.label :display_name, class: "font-medium" %>
      <%= form.text_field :display_name, placeholder: t(".display_name_placeholder"), class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="sm:flex sm:items-center sm:gap-4">
      <%= form.submit t(".submit"), data: { turbo_submits_with: t(".submitting") }, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
      <p class="mt-4 text-sm text-gray-500 sm:mt-0"><%= t(".submit_hint") %></p>
    </div>
  <% end %>
</div>
