<% content_for :title, t(".title") %>

<div class="mx-auto max-w-[720px]">
  <%= render "shared/page_header", title: t(".title"), lede: t(".intro") %>

  <%# Inside an alert the link takes the alert's own colour, so it carries no token
      of its own — only the weight and the underline that make it read as a link. %>
  <% show_me_how = link_to t(".show_me_how"), @guide.present? ? guide_path(@guide) : guides_path,
        target: "_blank", rel: "noopener",
        class: "inline-flex items-center font-semibold underline max-lg:min-h-11" %>

  <% if @detection_failure %>
    <%= render "shared/alert", variant: :warning, id: "detection-error", class: "mb-5",
          title: t(".detection.#{@detection_failure}", domain: @mail_account.email_address.to_s.split("@").last),
          body: safe_join([ t(".detection.hint"), " ", show_me_how ]) %>
  <% end %>

  <% if @connection_outcome %>
    <%= render "shared/alert", variant: :danger, id: "connection-error", class: "mb-5",
          title: t(".outcomes.#{@connection_outcome}.title"),
          body: safe_join([ t(".outcomes.#{@connection_outcome}.hint"), " ", show_me_how ]) %>
  <% end %>

  <%= form_with model: @mail_account, class: "contents" do |form| %>
    <%= render "shared/error_summary", model: @mail_account %>

    <%= render "shared/field", form: form, attribute: :email_address, type: :email,
          input: { required: true, autofocus: true, autocomplete: "email", autocapitalize: "off",
                   spellcheck: false, placeholder: "you@example.com" } %>

    <%= render "shared/field", form: form, attribute: :password, type: :password,
          hint: safe_join([ t(".password_hint"), " ",
                            link_to(t(".show_me_how"), guides_path, target: "_blank", rel: "noopener",
                                    class: "inline-flex items-center font-semibold text-green underline hover:text-green-deep max-lg:min-h-11") ]),
          input: { required: true, autocomplete: "new-password" } %>

    <%# Native disclosure, like the FAQ: closed for everyone detection works for, opened
        whenever the person has to see or type the settings themselves. None of the fields
        inside is `required`, or a closed disclosure would block the submit. %>
    <%= tag.details open: @detection_failure.present? || @mail_account.host.present?,
          class: "my-5 rounded-2xl border border-line bg-surface px-[22px] py-[18px]", id: "connection-details" do %>
      <summary class="flex cursor-pointer items-center gap-3.5 font-heading text-[19px] font-bold max-lg:min-h-11">
        <span aria-hidden="true" class="faq-mark inline-flex size-[26px] flex-none items-center justify-center rounded-full bg-brand-tint text-[18px] text-brand-deep">+</span>
        <%= t(".connection_details") %>
      </summary>
      <p class="mt-3 ml-10 text-base leading-[1.6] text-ink-soft"><%= t(".connection_details_hint") %></p>

      <div class="mt-1 grid gap-x-4 sm:grid-cols-6">
        <%= render "shared/field", form: form, attribute: :host, class: "my-5 sm:col-span-3",
              input: { placeholder: "imap.example.com", autocapitalize: "off", spellcheck: false } %>
        <%= render "shared/field", form: form, attribute: :port, type: :number, class: "my-5 sm:col-span-1",
              input: { min: 1, max: 65535 } %>
        <%= render "shared/field", form: form, attribute: :tls_mode, type: :select, class: "my-5 sm:col-span-2",
              choices: MailAccount::TLS_MODES.map { |mode| [ t(".tls_modes.#{mode}"), mode ] } %>
      </div>

      <%= render "shared/field", form: form, attribute: :username, class: "mt-1 mb-2",
            input: { autocomplete: "off", autocapitalize: "off", spellcheck: false,
                     placeholder: t(".username_placeholder") } %>
    <% end %>

    <div class="mt-8 sm:flex sm:items-center sm:gap-4">
      <%= button_submit form, t(".submit"), submitting: t(".submitting"),
            class: "w-full justify-center sm:w-auto" %>
      <p class="mt-4 text-sm text-ink-muted sm:mt-0"><%= t(".submit_hint") %></p>
    </div>
  <% end %>
</div>
