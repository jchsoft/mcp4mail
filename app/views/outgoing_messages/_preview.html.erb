<%# The whole message as it will leave, shown before the owner decides: in the approval
    email, on the approval page and under a mailbox on the mailboxes page.

    Locals:
      outgoing_message: the OutgoingMessage %>
<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
  <dt class="font-semibold"><%= t("outgoing_messages.preview.from") %></dt>
  <dd><%= outgoing_message.mail_account.sender_address %></dd>
  <dt class="font-semibold"><%= t("outgoing_messages.preview.to") %></dt>
  <dd><%= outgoing_message.to_addresses.join(", ") %></dd>
  <% if outgoing_message.cc_addresses.any? %>
    <dt class="font-semibold"><%= t("outgoing_messages.preview.cc") %></dt>
    <dd><%= outgoing_message.cc_addresses.join(", ") %></dd>
  <% end %>
  <% if outgoing_message.bcc_addresses.any? %>
    <dt class="font-semibold"><%= t("outgoing_messages.preview.bcc") %></dt>
    <dd><%= outgoing_message.bcc_addresses.join(", ") %></dd>
  <% end %>
  <dt class="font-semibold"><%= t("outgoing_messages.preview.subject") %></dt>
  <dd><%= outgoing_message.subject %></dd>
</dl>
<pre class="mt-3 whitespace-pre-wrap break-words rounded-xl border border-line bg-surface p-4 font-sans text-sm text-ink"><%= outgoing_message.body %></pre>
