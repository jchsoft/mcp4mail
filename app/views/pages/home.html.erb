<% content_for :title, t(".title") %>

<section class="mx-auto max-w-2xl text-center">
  <h1 class="text-5xl font-bold tracking-tight">mcp4mail</h1>
  <p class="mt-6 text-lg text-gray-600"><%= t(".tagline") %></p>
  <div class="mt-10 flex justify-center gap-4">
    <% if authenticated? %>
      <%= link_to t(".mailboxes"), mail_accounts_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    <% else %>
      <%= link_to t(".get_started"), new_registration_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    <% end %>
    <%= link_to t(".connect_ai"), connect_ai_path, class: "rounded-md px-3.5 py-2.5 border border-gray-300 hover:bg-gray-50 font-medium" %>
  </div>
  <p class="mt-10 text-sm text-gray-500">
    <%= link_to t(".source"), "https://github.com/jchsoft/mcp4mail", class: "underline hover:text-gray-900" %>
  </p>
</section>
