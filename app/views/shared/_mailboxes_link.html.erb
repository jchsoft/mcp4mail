<%# Beside the account link in both headers: an envelope carrying how many
    mailboxes the signed-in person has connected, one link to the mailbox list.
    Task #13187. The label states the count as "label: N" so Czech needs no
    plural forms. %>
<% mailbox_count = current_user.mail_accounts.count %>
<%= link_to main_app.mail_accounts_path,
            id: "mailboxes-link",
            aria: { label: t("nav.mailboxes_count", count: mailbox_count),
                    current: ("page" if current_page?(main_app.mail_accounts_path)) },
            class: "group relative inline-flex size-8 flex-none items-center justify-center rounded-full bg-brand-tint text-brand-deep no-underline hover:bg-brand aria-[current=page]:text-ink max-lg:size-11" do %>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-[55%]"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
  <span aria-hidden="true" class="absolute -top-1.5 -right-1.5 inline-flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-ink px-1 text-[11px] leading-none font-bold text-white"><%= mailbox_count %></span>
<% end %>
