<%# The top of every signed-in screen: the page h1, an optional lede and an
    optional action on the right (the "Add a mailbox" button on the index).

    Render it with title: and, if the screen has one, lede:. A block passed to
    render fills the action slot; leave it off and the heading runs full width.
    The h1 is the internal-page size from GUIDELINES.md section 4, not the fluid
    landing text-h1. %>
<% action = yield %>
<div class="mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
  <div class="max-w-[640px]">
    <h1 class="font-heading text-4xl font-extrabold tracking-[-0.02em] text-ink"><%= title %></h1>
    <% if local_assigns[:lede].present? %>
      <p class="mt-3 text-[17px] leading-[1.6] text-ink-soft"><%= lede %></p>
    <% end %>
  </div>
  <% if action.present? %>
    <div class="flex flex-wrap items-center gap-3"><%= action %></div>
  <% end %>
</div>
